<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KeepingYouAwake</RootNamespace>
    <AssemblyName>KeepingYouAwake</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\TrayActive.png" LogicalName="TrayActive.png" />
    <EmbeddedResource Include="Resources\TrayInactive.png" LogicalName="TrayInactive.png" />
    <EmbeddedResource Include="Resources\AppIcon.ico" LogicalName="AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KeepingYouAwake.Core\KeepingYouAwake.Core.csproj" />
  </ItemGroup>
</Project>
