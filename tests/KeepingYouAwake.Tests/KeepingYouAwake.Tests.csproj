<Project Sdk="Microsoft.NET.Sdk">
  <!-- Component and platform tests for the WinForms app. They run on Windows only
       (CI: windows-latest); elsewhere the project builds but has nothing to run. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Lets coverlet resolve the Windows Desktop assemblies (System.Windows.Forms) while it
         instruments KeepingYouAwake.dll; without it the module is skipped and reports no coverage. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Shares the platform fakes and controller harness with the Core tests. -->
    <Compile Include="..\KeepingYouAwake.Core.Tests\Fakes.cs" Link="Shared\Fakes.cs" />
    <ProjectReference Include="..\..\src\KeepingYouAwake\KeepingYouAwake.csproj" />
  </ItemGroup>
</Project>
